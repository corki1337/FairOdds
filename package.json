{
  "name": "aichain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "npm run test:rust && npm run test:integration",
    "test:rust": "cargo test -p aichain --lib && cargo test -p yield-park --lib",
    "test:integration": "bash scripts/build-programs.sh && cargo test --manifest-path tests/program-test/Cargo.toml --test integration -- --test-threads=1",
    "fixtures:fetch": "ts-node --transpile-only scripts/fetch-fixtures.ts",
    "idl:patch": "ts-node --transpile-only scripts/patch-idl.ts",
    "setup:devnet": "ts-node --transpile-only scripts/setup-devnet.ts",
    "markets:create": "ts-node --transpile-only scripts/create-from-fixture.ts",
    "markets:seed": "ts-node --transpile-only scripts/seed-liquidity.ts",
    "crank": "ts-node --transpile-only scripts/resolve-crank.ts",
    "keeper": "ts-node --transpile-only scripts/keeper.ts",
    "sources:probe": "ts-node --transpile-only scripts/probe-sources.ts",
    "test:sources": "ts-mocha -p tsconfig.json --timeout 10000 scripts/sources/*.test.ts",
    "smoke:devnet": "ts-node --transpile-only scripts/smoke-devnet.ts",
    "test:api": "ts-mocha -p tsconfig.json tests/api/*.test.ts",
    "idl:generate": "python3 scripts/generate-idl.py && python3 scripts/generate-idl.py yield_park",
    "catalog:publish": "ts-node --transpile-only scripts/publish-catalog.ts",
    "seasons:prepare": "ts-node --transpile-only scripts/prepare-season.ts",
    "typecheck": "tsc --noEmit",
    "bot": "ts-node --transpile-only examples/bot/simple-bot.ts",
    "test:browser": "node tests/browser/smoke.mjs",
    "slides:pdf": "node scripts/render-slides.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@switchboard-xyz/common": "^5.8.5",
    "@switchboard-xyz/on-demand": "^3.10.6"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
