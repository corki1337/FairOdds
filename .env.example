# Copy to .env. Every key is optional: a source without its key is skipped and never votes.
# TheSportsDB and OpenLigaDB need no key and are always used.

# football-data.org (free plan ~10 req/min, bigger European competitions)
FOOTBALL_DATA_KEY=

# API-Football / api-sports.io (free plan 100 req/day). Used only for result checks.
API_FOOTBALL_KEY=
# Requests the keeper may spend per UTC day (stay under the plan limit).
API_FOOTBALL_DAILY=90

# PandaScore free fixtures plan (1000 req/h): esports schedules and series results.
PANDASCORE_TOKEN=

# Keeper (scripts/keeper.ts)
# Markets to keep open ahead of kickoff, catalog refresh period and crank period.
KEEPER_MARKETS=8
KEEPER_CATALOG_HOURS=6
KEEPER_CRANK_SECONDS=30
# Resolve window after the expected end of the match, in minutes (default 2 days).
RESOLVE_WINDOW_MINS=2880
