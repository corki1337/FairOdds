# Copy to .env. Match result providers without their optional key abstain.
# Season preparation and hosted keeper/storage require the variables documented below.
# TheSportsDB and OpenLigaDB need no key and are always used.

# football-data.org (free plan ~10 req/min, bigger European competitions)
FOOTBALL_DATA_KEY=

# API-Football / api-sports.io (free plan 100 req/day). Used only for result checks.
API_FOOTBALL_KEY=
# Requests the keeper may spend per UTC day (stay under the plan limit).
API_FOOTBALL_DAILY=90

# PandaScore free fixtures plan (1000 req/h): esports schedules and series results.
PANDASCORE_TOKEN=

# Keeper (scripts/keeper.ts)
# Markets to keep open ahead of kickoff per category, catalog refresh period and crank period.
KEEPER_MARKETS_FOOTBALL=10
KEEPER_MARKETS_CS2=5
KEEPER_MARKETS_LOL=5
KEEPER_MARKETS_ESPORTS=5
KEEPER_CATALOG_HOURS=6
KEEPER_CRANK_SECONDS=30
# Resolve window after the expected end of the match, in minutes (default 2 days).
RESOLVE_WINDOW_MINS=2880

# Server RPC: never prefix a private RPC token with NEXT_PUBLIC_.
RPC_URL=https://api.devnet.solana.com
RPC_FALLBACKS=
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
# CLI authority keypair path; needed for creating markets, not permissionless settlement.
ANCHOR_WALLET=
# Hosting: separate funded devnet keeper, JSON secret-key array or base58. Never browser public.
KEEPER_PRIVATE_KEY=
CRON_SECRET=
# Shared Redis REST (Upstash/Vercel). Required for durable hosting writes and distributed leases.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional absolute paths. Defaults work from root scripts and app/.
SEASON_CONFIG_PATH=
SEASON_ALIASES_PATH=
# Real season betting cutoff and expected finality, Unix seconds. Demo computes a short window.
SEASON_CUTOFF=
SEASON_END_TIME=
# Bot example (wallet remains local). Dry run unless BOT_SEND=1.
FAIRODDS_URL=http://localhost:3000
BOT_WALLET_PATH=
BOT_STAKE=1
BOT_SEND=0
